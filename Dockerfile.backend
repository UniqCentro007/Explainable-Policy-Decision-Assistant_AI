# Backend Dockerfile for Explainable-Policy-Decision-Assistant_AI
FROM python:3.12-slim

WORKDIR /app

# Install system packages for Python dependencies and cleanup
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY policy-assistant /app/policy-assistant
COPY .env /app/.env

EXPOSE 8080

CMD ["uvicorn", "policy-assistant.app.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]
