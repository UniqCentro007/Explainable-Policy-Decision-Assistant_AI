# Frontend Dockerfile for Explainable-Policy-Decision-Assistant_AI
FROM node:20-alpine

WORKDIR /usr/src/app

COPY policy-frontend/package.json policy-frontend/package-lock.json ./
RUN npm install

COPY policy-frontend ./
RUN npm run build

EXPOSE 5173
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5173"]
